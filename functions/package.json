{
  "name": "werkbuch-functions",
  "description": "Cloud Functions für WerkBuch — Kundenportal, Zulagen, Freigabe-Protokoll",
  "version": "1.0.0",
  "type": "module",
  "main": "index.js",
  "engines": {
    "node": "20"
  },
  "scripts": {
    "serve": "firebase emulators:start --only functions,firestore,auth",
    "test": "node --test \"test/zulagen.test.js\" \"test/magicLink.test.js\" \"test/abdruck.test.js\" \"test/freigabe.test.js\"",
    "test:regeln": "firebase emulators:exec --only firestore \"node --test test/regeln.test.js\"",
    "deploy": "firebase deploy --only functions"
  },
  "dependencies": {
    "firebase-admin": "^12.7.0",
    "firebase-functions": "^6.1.0",
    "nodemailer": "^6.9.16"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^4.0.1",
    "firebase": "^11.0.0"
  },
  "private": true
}
