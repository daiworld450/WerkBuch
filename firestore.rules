rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function angemeldet() { return request.auth != null; }
    function meineUid()   { return request.auth.uid; }

    // Zugriff auf das Baustellen-Hauptdokument
    function istHandwerkerVon(bid) {
      return get(/databases/$(database)/documents/baustellen/$(bid)).data.handwerkerId == meineUid();
    }
    // Hier stand bis zum 09.09.2026 istKundeVon(bid). Die Prüfung hing an
    // baustellen/{bid}.kundeId — einem Feld, das seit dem Ausbau des
    // Kundenteils niemand mehr schreibt. Die Regel lief damit ins Leere und
    // kostete bei jeder Auswertung einen zusätzlichen Dokumentabruf.
    //
    // Der Kunde kommt jetzt auf einem anderen Weg herein: Er meldet sich gar
    // nicht an, sondern öffnet einen Link, dessen Schlüssel selbst der
    // Nachweis der Berechtigung ist (siehe freigabeLinks ganz unten).

    // Ist der Angemeldete dieser Baustelle als Mitarbeiter zugewiesen?
    //
    // Die Zuweisung steht als Liste von uids im Feld zugewieseneNutzer auf
    // dem Baustellen-Dokument; geschrieben wird sie ausschließlich vom
    // Inhaber (siehe update-Regel für baustellen). Der Standardwert []
    // deckt die alten Baustellen ab, auf denen das Feld noch gar nicht
    // existiert — ohne ihn würde die Regel dort mit einem Fehler abbrechen
    // statt schlicht "nein" zu sagen.
    function istZugewiesen(bid) {
      return meineUid() in
        get(/databases/$(database)/documents/baustellen/$(bid)).data.get('zugewieseneNutzer', []);
    }

    // Unterordner einer Baustelle, die ihre EIGENE, engere Regel mitbringen.
    // Sie werden weiter unten von der allgemeinen Sammelregel ausgenommen —
    // an einer Stelle gepflegt, damit read und write nicht auseinanderlaufen.
    //
    // "material", "kosten" und "stunden" kamen mit der Nachkalkulation dazu:
    // material und kosten enthalten Preise und müssen dem zugewiesenen
    // Mitarbeiter verborgen bleiben, stunden erlaubt ihm umgekehrt mehr als
    // die Sammelregel (eigene Einträge schreiben). Fehlt hier ein Eintrag,
    // hebt die weite Sammelregel die engere Regel wieder auf.
    function eigeneRegeln() {
      return ['angebot', 'freigaben', 'protokoll', 'guthaben',
              'zulagenBestellungen', 'nachrichten', 'dokumente',
              'material', 'kosten', 'stunden', 'nachtraege'];
    }

    function istHandwerker() {
      return angemeldet() &&
        get(/databases/$(database)/documents/users/$(meineUid())).data.rolle == 'handwerker';
    }

    // Betriebsinhaber — geprüft über das von Google signierte ID-Token, nicht
    // über ein Firestore-Feld. request.auth.token.email/email_verified kommen
    // direkt aus dem Token und sind damit anders als "rolle" nicht durch
    // einen einfachen Dokument-Schreibzugriff fälschbar.
    //
    // Grund: "rolle" in users/{uid} ist eine Selbstauskunft bei der
    // Registrierung — jeder Angemeldete konnte sie sich (vor dieser
    // Korrektur) auch nachträglich selbst zuweisen. Für Ressourcen, die den
    // ganzen Betrieb betreffen (aktuell nur der Zulagenkatalog: eine
    // GLOBALE Sammlung ohne Baustellenbezug, aus der der Server direkt die
    // Rechnungsgrundlage lädt), reicht "rolle" deshalb nicht als Schutz.
    //
    // Korrigiert am 09.09.2026: Hier stand berisabau@gmail.com. Dieses Konto
    // wurde am 05.09. gelöscht — die Prüfung traf damit auf niemanden mehr zu
    // und der Zulagenkatalog war für alle schreibgesperrt, ohne dass es
    // auffiel. Jetzt steht hier das tatsächlich genutzte Betriebskonto.
    function istBesitzer() {
      return angemeldet() &&
        request.auth.token.email == 'info@berisabau.de' &&
        request.auth.token.email_verified == true;
    }

    // -------------------------------------------------------------- users
    match /users/{uid} {
      // Angemeldete dürfen Profile lesen (nötig, um Kunden per E-Mail zu finden)
      allow read: if angemeldet();
      allow create: if angemeldet() && uid == meineUid();
      // "rolle" ist nach dem Anlegen unveränderlich — sonst könnte sich ein
      // bereits bestehendes Konto nachträglich selbst zum Handwerker machen.
      // Das gilt jetzt auch für die dritte Rolle "mitarbeiter": Wer einmal
      // als Mitarbeiter angelegt wurde, kann sich nicht selbst zum Inhaber
      // befördern. Alle anderen Felder bleiben frei änderbar.
      allow update: if angemeldet() && uid == meineUid() &&
        request.resource.data.rolle == resource.data.rolle;
      allow delete: if angemeldet() && uid == meineUid();
    }

    // ------------------------------------------------------------ termine
    // Kalender-Termine des Betriebsinhabers. Bewusst TOP-LEVEL und nicht als
    // Unterordner einer Baustelle: der Kalender braucht alle Termine mit
    // EINER Abfrage (where handwerkerId == uid), unabhängig davon, ob eine
    // Baustelle verknüpft ist. Die optionale baustelleId ist reine
    // Anzeige-Information und gewährt keinerlei zusätzlichen Zugriff.
    //
    // SICHTBARKEIT FÜR MITARBEITER (ergänzt am 09.09.2026):
    // Der Kalender enthält auch Büro- und Privattermine des Inhabers. Deshalb
    // wird NICHT pauschal freigegeben, sondern je Termin: Das Feld
    // sichtbarFuer[] enthält die uids, die ihn außerdem sehen dürfen.
    // Geschrieben wird es ausschließlich vom Inhaber (create/update unten
    // verlangen handwerkerId == eigene uid) — ein Mitarbeiter kann sich also
    // nicht selbst in fremde Termine eintragen.
    //
    // Genau dieser Weg war hier schon als der richtige vermerkt; jetzt ist er
    // gebaut.
    match /termine/{terminId} {
      allow read: if angemeldet() && (
        resource.data.handwerkerId == meineUid() ||
        meineUid() in resource.data.get('sichtbarFuer', [])
      );
      allow create: if angemeldet() && request.resource.data.handwerkerId == meineUid();
      allow update, delete: if angemeldet() && resource.data.handwerkerId == meineUid();
    }

    // --------------------------------------------------------- baustellen
    // Enthält u.a. geplantStart/geplantEnde (Einsatzplanung/Kalenderübersicht),
    // umsatz/budget (Grundlage der Nachkalkulation) und zugewieseneNutzer:
    // die Liste der Mitarbeiter-uids, die diese Baustelle sehen dürfen.
    // Beschrieben wird sie im Abschnitt "Wer arbeitet hier" des
    // Baustellen-Bildschirms und fällt unter die update-Regel unten — nur
    // der Handwerker selbst darf sie ändern.
    //
    // Kein Kunden-Konto mehr: kundeName/kundeTelefon sind reine
    // Kontakt-Information auf der Baustelle, kein eigener Zugriff darüber.
    match /baustellen/{bid} {
      // Lesen darf jetzt auch, wer der Baustelle als Mitarbeiter zugewiesen
      // ist. Hier wird bewusst NICHT istZugewiesen(bid) benutzt: bei einer
      // Abfrage (where zugewieseneNutzer array-contains uid) liegt das
      // Dokument bereits als resource.data vor — ein zusätzliches get()
      // wäre ein vermeidbarer Lesevorgang pro Treffer.
      allow read: if angemeldet() && (
        resource.data.handwerkerId == meineUid() ||
        meineUid() in resource.data.get('zugewieseneNutzer', [])
      );
      allow create: if angemeldet() && request.resource.data.handwerkerId == meineUid();
      // Ändern und Löschen bleibt AUSSCHLIESSLICH beim Inhaber. Der
      // Mitarbeiter darf weder Status, Umsatz, Budget noch die Zuweisung
      // selbst anfassen — sonst könnte er sich auf jede Baustelle setzen.
      allow update: if angemeldet() && resource.data.handwerkerId == meineUid();
      allow delete: if angemeldet() && resource.data.handwerkerId == meineUid();

      // Angebot: Die Angebotskachel wurde am 09.09.2026 aus der App entfernt —
      // Angebote entstehen im Angebotswerkzeug auf dem Mac. Die Regel bleibt
      // stehen: Sollten aus der Zeit davor noch Angebotsdaten liegen, sind sie
      // weiterhin nur für den Inhaber lesbar. Ohne diese Regel fielen sie unter
      // die weite Sammelregel ganz unten und wären für zugewiesene Mitarbeiter
      // sichtbar — samt Beträgen.
      match /angebot/{docId} {
        allow read, write: if angemeldet() && istHandwerkerVon(bid);
      }

      // Interne Dokumenten-Ablage (Teil B): beliebige Dateien pro Baustelle,
      // nur für den Handwerker.
      match /dokumente/{dokId} {
        allow read, write: if angemeldet() && istHandwerkerVon(bid);
      }

      // ------------------------------------------------ Nachkalkulation
      // Material enthält Einkaufspreise. Bis zur Mitarbeiter-Stufe lief es
      // über die Sammelregel ganz unten — die gibt einem zugewiesenen
      // Mitarbeiter jetzt aber Lesezugriff. Deshalb hier eine eigene, enge
      // Regel (und der Eintrag in eigeneRegeln()): Preise sind Sache des
      // Inhabers.
      match /material/{matId} {
        allow read, write: if angemeldet() && istHandwerkerVon(bid);
      }

      // Sonstige Kosten (Fahrt, Werkzeug, Fremdleistung). Reine
      // Betriebszahlen — der Mitarbeiter sieht sie nicht einmal lesend.
      match /kosten/{kostenId} {
        allow read, write: if angemeldet() && istHandwerkerVon(bid);
      }

      // Arbeitsstunden. Die einzige Sammlung, in die ein Mitarbeiter
      // schreiben darf — und dort ausschließlich EIGENE Einträge.
      //
      // erstelltVon ist der Anker dafür. Beim Anlegen muss es die eigene uid
      // sein, beim Ändern muss der BESTEHENDE Eintrag ihm gehören UND er
      // muss ihm hinterher noch gehören — ohne die zweite Prüfung könnte er
      // einen eigenen Eintrag auf einen Kollegen umschreiben und ihn danach
      // nicht mehr korrigieren, oder umgekehrt fremde Einträge übernehmen.
      //
      // Der eingefrorene stundensatzKosten wird hier NICHT geprüft: er ist
      // eine Kostengröße des Betriebs, und wer Stunden schreiben darf, kann
      // die Kalkulation ohnehin über die Stundenzahl beeinflussen. Die
      // Kontrolle darüber liegt beim Inhaber, der jeden Eintrag sieht.
      match /stunden/{stundenId} {
        allow read: if angemeldet() &&
          (istHandwerkerVon(bid) || istZugewiesen(bid));
        allow create: if angemeldet() && (
          istHandwerkerVon(bid) ||
          (istZugewiesen(bid) && request.resource.data.erstelltVon == meineUid())
        );
        allow update: if angemeldet() && (
          istHandwerkerVon(bid) ||
          (istZugewiesen(bid) &&
           resource.data.erstelltVon == meineUid() &&
           request.resource.data.erstelltVon == meineUid())
        );
        allow delete: if angemeldet() && (
          istHandwerkerVon(bid) ||
          (istZugewiesen(bid) && resource.data.erstelltVon == meineUid())
        );
      }

      // ------------------------------------------------ Nachweis-Sammlungen
      // Freigaben, Protokoll und Guthaben sind BEWEISUNTERLAGEN. Sie werden
      // ausschließlich serverseitig durch die Cloud Functions geschrieben
      // (das Admin-SDK umgeht diese Regeln) und sind hier für jeden Client
      // schreibgeschützt — auch für den Handwerker.
      //
      // Ohne diese Sperre wäre der ganze Nachweis wertlos: Wer nachträglich
      // ändern kann, was der Kunde freigegeben hat, kann nichts belegen.
      // -------------------------------------------------------- Nachträge
      // Zusätzliche Leistungen, die während der Bauzeit dazukommen: Titel,
      // Beschreibung, Menge, Einheit, Einzelpreis in CENT, dazu Fotos und der
      // Stand (offen → gesendet → freigegeben/abgelehnt → abgerechnet).
      //
      // Nur der Inhaber schreibt hier. Der Kunde sieht einen Nachtrag NIE über
      // diese Sammlung, sondern ausschließlich über den eingefrorenen Stand in
      // freigabeLinks (ganz unten) — er bekommt damit keinerlei Zugriff auf
      // die Baustelle selbst.
      match /nachtraege/{nid} {
        allow read, write: if angemeldet() && istHandwerkerVon(bid);
      }

      match /freigaben/{freigabeId} {
        allow read: if angemeldet() && istHandwerkerVon(bid);
        allow write: if false;
      }

      match /protokoll/{eintragId} {
        allow read: if angemeldet() && istHandwerkerVon(bid);
        allow write: if false;
      }

      match /guthaben/{eintragId} {
        allow read: if angemeldet() && istHandwerkerVon(bid);
        allow write: if false;
      }

      match /zulagenBestellungen/{bestellId} {
        allow read: if angemeldet() && istHandwerkerVon(bid);
        // Nur der Handwerker darf einen Sonderwunsch bepreisen bzw. eine
        // wartende Bestellung freigeben — und dabei ausschließlich die dafür
        // nötigen Felder anfassen, nicht Positionen oder Beträge der
        // ursprünglichen Kundenbestellung.
        allow update: if angemeldet() && istHandwerkerVon(bid) &&
          request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['status', 'pruefGrund', 'preisNotiz', 'geprueftAm', 'geprueftVon']) &&
          request.resource.data.status in ['bestaetigt', 'abgelehnt', 'wartet_auf_pruefung'];
        allow create, delete: if false;
      }

      match /nachrichten/{nachrichtId} {
        allow read: if angemeldet() && istHandwerkerVon(bid);
        allow create: if angemeldet() && istHandwerkerVon(bid);
        allow update, delete: if false;
      }

      // Alle übrigen Unterordner (fotos, masse, raum):
      // lesen und schreiben für Handwerker und zugewiesene Mitarbeiter.
      //
      // Der Mitarbeiter soll Fotos hochladen und Maße erfassen können — das
      // ist genau der Zweck seines Zugangs. Material, kosten und stunden
      // fallen NICHT mehr hierunter, sie stehen oben in eigeneRegeln().
      //
      // ACHTUNG: Firestore verknüpft alle passenden Regeln mit ODER. Diese
      // Sammelregel greift deshalb AUCH auf die oben genannten Sammlungen —
      // ohne den Ausschluss würde sie deren engere Regeln wieder aufheben:
      // die Schreibsperre der Nachweise ebenso wie die Leseeinschränkung des
      // Protokolls. Der Ausschluss muss deshalb für read UND write gelten;
      // die eigenen Regeln oben erteilen die Rechte, die dort gelten sollen.
      //
      // Wer später eine weitere geschützte Sammlung ergänzt, muss sie AUCH
      // hier eintragen — sonst greift wieder diese weite Regel.
      match /{unterordner}/{docId} {
        allow read: if angemeldet() &&
          (istHandwerkerVon(bid) || istZugewiesen(bid)) &&
          !(unterordner in eigeneRegeln());
        allow write: if angemeldet() &&
          (istHandwerkerVon(bid) || istZugewiesen(bid)) &&
          !(unterordner in eigeneRegeln());
      }
    }

    // ----------------------------------------------------------- personen
    // Wer im Betrieb auf Baustellen arbeitet, mit seinem internen
    // Stundensatz. Top-level, weil die Personen baustellenübergreifend
    // gelten und die Registrierung sie ohne Baustellenbezug finden muss.
    //
    // read für jeden Angemeldeten: Bei der Registrierung muss das frisch
    // angelegte Konto prüfen können, ob der Inhaber für seine E-Mail einen
    // Personen-Eintrag hinterlegt hat — erst daraus entsteht die Rolle
    // "mitarbeiter". Zu diesem Zeitpunkt gibt es noch kein users-Dokument,
    // an dem sich etwas Engeres festmachen ließe.
    //
    // Die Sammlung enthält deshalb bewusst NUR Name, Stundensatz, E-Mail und
    // uid — keine Bankdaten, keine Adressen. Wer sie liest, erfährt, wer im
    // Betrieb arbeitet und was die Stunde kostet. Das ist der Preis dafür,
    // dass die Konto-Verknüpfung ohne Mailserver und ohne Cloud Function
    // auskommt.
    match /personen/{personId} {
      allow read: if angemeldet();
      allow create: if angemeldet() &&
        request.resource.data.handwerkerId == meineUid();
      allow delete: if angemeldet() && resource.data.handwerkerId == meineUid();

      // Zwei erlaubte Schreibwege:
      //   1. Der Inhaber ändert seine eigene Person.
      //   2. SELBSTVERKNÜPFUNG bei der Registrierung: Wer sich mit genau der
      //      hinterlegten E-Mail anmeldet, trägt seine uid ein — und sonst
      //      NICHTS. hasOnly(['uid']) verhindert, dass er sich dabei den
      //      Stundensatz, den Namen oder den Betrieb umschreibt; die
      //      E-Mail-Prüfung läuft über request.auth.token.email aus dem von
      //      Google signierten Token, nicht über ein Firestore-Feld.
      allow update: if angemeldet() && (
        resource.data.handwerkerId == meineUid() ||
        (resource.data.email == request.auth.token.email &&
         request.resource.data.diff(resource.data).affectedKeys().hasOnly(['uid']) &&
         request.resource.data.uid == meineUid())
      );
    }

    // ------------------------------------------------------ zulagenKatalog
    // Preise und Beschreibungen der wählbaren Zusatzleistungen.
    // Der Kunde im Portal liest sie nicht hierüber, sondern bekommt sie von
    // der Cloud Function geliefert — er ist ja nicht angemeldet.
    //
    // Schreibrecht bewusst NICHT über istHandwerker(): diese Sammlung ist
    // global (nicht an eine Baustelle gebunden), ihr Inhalt bestimmt direkt
    // die Rechnungsgrundlage jeder Freigabe. Nur der Betriebsinhaber selbst
    // darf sie ändern.
    match /zulagenKatalog/{sku} {
      allow read: if angemeldet();
      allow write: if istBesitzer();
    }

    // ----------------------------------------------------------- magicLinks
    // Enthält die Zugangs-Abdrücke der Kundenlinks. Kein Client darf hier
    // lesen oder schreiben: Wer diese Sammlung lesen könnte, sähe, welche
    // Zugänge existieren, und könnte Verifikations-Zähler zurücksetzen.
    // Ausschließlich die Cloud Functions greifen darauf zu.
    match /magicLinks/{tokenAbdruck} {
      allow read, write: if false;
    }

    // ================================================== Freigabe durch den Kunden
    //
    // Das Herzstück des Nachtragswegs — und die einzige Stelle, an der jemand
    // ohne Anmeldung etwas zu sehen bekommt. Deshalb hier ausführlicher.
    //
    // GRUNDGEDANKE: Der Kunde bekommt keinen Zugang zur Baustelle. Er bekommt
    // einen Link, und in dessen Dokument steht bereits ALLES, was er sehen
    // soll — als eingefrorene Kopie. Er liest nie in baustellen/ hinein. Damit
    // kann über diesen Weg auch nichts durchsickern, was ihn nichts angeht:
    // keine Einkaufspreise, keine Stunden, keine anderen Kunden.
    //
    // WARUM OHNE ANMELDUNG: Ein Kunde, der auf der Baustelle steht und eine
    // zusätzliche Leistung freigeben soll, installiert keine App und legt kein
    // Passwort an. Der 32-stellige Schlüssel IM PFAD ist der Berechtigungs-
    // nachweis. Er stammt aus einer kryptografischen Zufallsquelle; das
    // Alphabet hat 57 Zeichen, macht 57^32 Möglichkeiten. Raten scheidet aus.
    match /freigabeLinks/{schluessel} {
      // get liest GENAU EIN Dokument, dessen Kennung man kennen muss.
      // list bleibt gesperrt — sonst könnte man sich die Sammlung auflisten
      // lassen und käme ganz ohne Schlüssel an jeden Nachtrag.
      allow get: if true;
      allow list: if false;

      allow create: if angemeldet() &&
        request.resource.data.handwerkerId == meineUid();

      // NACH DEM ANLEGEN UNVERÄNDERLICH, bis auf das Zurückziehen.
      //
      // Das ist die Regel, an der die Beweiskraft hängt. Wäre der gezeigte
      // Stand nachträglich änderbar, könnte man nach der Freigabe den Preis
      // hochsetzen und behaupten, der Kunde habe das so freigegeben. Der
      // Nachweis wäre wertlos — und zwar genau in dem Moment, in dem man ihn
      // braucht. Deshalb darf hier auch der Inhaber nur noch zurückziehen.
      allow update: if angemeldet() &&
        resource.data.handwerkerId == meineUid() &&
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['widerrufen', 'widerrufenAm']);

      allow delete: if angemeldet() && resource.data.handwerkerId == meineUid();
    }

    // Die Entscheidung des Kunden. Ein Dokument je Link, mit demselben
    // Schlüssel als Kennung — dadurch kann es EINE Entscheidung geben und
    // keine zweite: ein erneuter Klick trifft auf ein vorhandenes Dokument und
    // wird abgewiesen. Das ist zugleich der Schutz gegen Doppelklick und gegen
    // Wiederholung nach einem Netzabbruch.
    match /freigabeEntscheidungen/{schluessel} {
      allow get: if true;
      allow list: if false;

      allow create: if
        // 1. Es muss einen echten Link mit diesem Schlüssel geben.
        exists(/databases/$(database)/documents/freigabeLinks/$(schluessel)) &&
        // 2. Er darf nicht zurückgezogen sein …
        get(/databases/$(database)/documents/freigabeLinks/$(schluessel))
          .data.get('widerrufen', false) == false &&
        // 3. … und nicht abgelaufen.
        request.time < get(/databases/$(database)/documents/freigabeLinks/$(schluessel))
          .data.gueltigBis &&
        // 4. DER ENTSCHEIDENDE PUNKT: Freigegeben wird genau der Stand, der im
        //    Link steht. Der Abdruck ist die Prüfsumme über alles Gezeigte —
        //    Betrag, Text, Fotos. Stimmt er nicht überein, wird abgewiesen,
        //    statt die Freigabe stillschweigend auf etwas anderes zu beziehen.
        request.resource.data.abdruck ==
          get(/databases/$(database)/documents/freigabeLinks/$(schluessel)).data.abdruck &&
        // 5. Nur diese beiden Ausgänge.
        request.resource.data.ergebnis in ['freigegeben', 'abgelehnt'] &&
        // 6. Der Zeitstempel kommt vom SERVER, nicht vom Gerät des Kunden.
        //    Eine falsch gestellte Uhr — oder ein absichtlich zurückgestelltes
        //    Handy — darf den Nachweis nicht datieren.
        request.resource.data.zeitpunkt == request.time &&
        // 7. Der ANGEZEIGTE TEXT IM WORTLAUT wird mitgespeichert, nicht bloß
        //    ein Verweis auf eine Vorlage. Ändert sich die Vorlage später,
        //    bleibt dieser Beleg, wie er war.
        request.resource.data.wortlaut is string &&
        request.resource.data.wortlaut.size() > 50 &&
        request.resource.data.wortlaut.size() < 20000;

      // Unveränderlich. Für beide Seiten, ohne Ausnahme, für immer.
      allow update, delete: if false;
    }
  }
}
