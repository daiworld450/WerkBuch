rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function angemeldet() { return request.auth != null; }
    function meineUid()   { return request.auth.uid; }

    // Zugriff auf das Baustellen-Hauptdokument
    function istHandwerkerVon(bid) {
      return get(/databases/$(database)/documents/baustellen/$(bid)).data.handwerkerId == meineUid();
    }
    function istKundeVon(bid) {
      return get(/databases/$(database)/documents/baustellen/$(bid)).data.kundeId == meineUid();
    }

    // Unterordner einer Baustelle, die ihre EIGENE, engere Regel mitbringen.
    // Sie werden weiter unten von der allgemeinen Sammelregel ausgenommen —
    // an einer Stelle gepflegt, damit read und write nicht auseinanderlaufen.
    function eigeneRegeln() {
      return ['angebot', 'freigaben', 'protokoll', 'guthaben',
              'zulagenBestellungen', 'nachrichten'];
    }

    function istHandwerker() {
      return angemeldet() &&
        get(/databases/$(database)/documents/users/$(meineUid())).data.rolle == 'handwerker';
    }

    // Betriebsinhaber — geprüft über das von Google signierte ID-Token, nicht
    // über ein Firestore-Feld. request.auth.token.email/email_verified kommen
    // direkt aus dem Token und sind damit anders als "rolle" nicht durch
    // einen einfachen Dokument-Schreibzugriff fälschbar.
    //
    // Grund: "rolle" in users/{uid} ist eine Selbstauskunft bei der
    // Registrierung — jeder Angemeldete konnte sie sich (vor dieser
    // Korrektur) auch nachträglich selbst zuweisen. Für Ressourcen, die den
    // ganzen Betrieb betreffen (aktuell nur der Zulagenkatalog: eine
    // GLOBALE Sammlung ohne Baustellenbezug, aus der der Server direkt die
    // Rechnungsgrundlage lädt), reicht "rolle" deshalb nicht als Schutz.
    function istBesitzer() {
      return angemeldet() &&
        request.auth.token.email == 'berisabau@gmail.com' &&
        request.auth.token.email_verified == true;
    }

    // -------------------------------------------------------------- users
    match /users/{uid} {
      // Angemeldete dürfen Profile lesen (nötig, um Kunden per E-Mail zu finden)
      allow read: if angemeldet();
      allow create: if angemeldet() && uid == meineUid();
      // "rolle" ist nach dem Anlegen unveränderlich — sonst könnte sich ein
      // bereits bestehendes Kundenkonto nachträglich selbst zum Handwerker
      // machen. Alle anderen Felder bleiben frei änderbar.
      allow update: if angemeldet() && uid == meineUid() &&
        request.resource.data.rolle == resource.data.rolle;
      allow delete: if angemeldet() && uid == meineUid();
    }

    // --------------------------------------------------------- baustellen
    match /baustellen/{bid} {
      allow read: if angemeldet() &&
        (resource.data.handwerkerId == meineUid() || resource.data.kundeId == meineUid());
      allow create: if angemeldet() && request.resource.data.handwerkerId == meineUid();
      allow update, delete: if angemeldet() && resource.data.handwerkerId == meineUid();

      // Sonderregel Angebot: der Kunde darf im Dokument angebot/aktuell
      // ausschließlich das Feld "status" (plus aktualisiertAm) auf
      // "Angenommen" oder "Abgelehnt" setzen.
      match /angebot/{docId} {
        allow read: if angemeldet() && (istHandwerkerVon(bid) || istKundeVon(bid));
        allow create, delete: if angemeldet() && istHandwerkerVon(bid);
        allow update: if angemeldet() && (
          // Handwerker: darf alles ändern
          istHandwerkerVon(bid) ||
          // Kunde: nur status (+ aktualisiertAm) und nur erlaubte Werte
          (
            istKundeVon(bid) &&
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'aktualisiertAm']) &&
            request.resource.data.status in ['Angenommen', 'Abgelehnt']
          )
        );
      }

      // ------------------------------------------------ Nachweis-Sammlungen
      // Freigaben, Protokoll und Guthaben sind BEWEISUNTERLAGEN. Sie werden
      // ausschließlich serverseitig durch die Cloud Functions geschrieben
      // (das Admin-SDK umgeht diese Regeln) und sind hier für jeden Client
      // schreibgeschützt — auch für den Handwerker.
      //
      // Ohne diese Sperre wäre der ganze Nachweis wertlos: Wer nachträglich
      // ändern kann, was der Kunde freigegeben hat, kann nichts belegen.
      match /freigaben/{freigabeId} {
        allow read: if angemeldet() && (istHandwerkerVon(bid) || istKundeVon(bid));
        allow write: if false;
      }

      match /protokoll/{eintragId} {
        allow read: if angemeldet() && istHandwerkerVon(bid);
        allow write: if false;
      }

      match /guthaben/{eintragId} {
        allow read: if angemeldet() && (istHandwerkerVon(bid) || istKundeVon(bid));
        allow write: if false;
      }

      match /zulagenBestellungen/{bestellId} {
        allow read: if angemeldet() && (istHandwerkerVon(bid) || istKundeVon(bid));
        // Nur der Handwerker darf einen Sonderwunsch bepreisen bzw. eine
        // wartende Bestellung freigeben — und dabei ausschließlich die dafür
        // nötigen Felder anfassen, nicht Positionen oder Beträge der
        // ursprünglichen Kundenbestellung.
        allow update: if angemeldet() && istHandwerkerVon(bid) &&
          request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['status', 'pruefGrund', 'preisNotiz', 'geprueftAm', 'geprueftVon']) &&
          request.resource.data.status in ['bestaetigt', 'abgelehnt', 'wartet_auf_pruefung'];
        allow create, delete: if false;
      }

      match /nachrichten/{nachrichtId} {
        allow read: if angemeldet() && (istHandwerkerVon(bid) || istKundeVon(bid));
        allow create: if angemeldet() && istHandwerkerVon(bid);
        allow update, delete: if false;
      }

      // Alle übrigen Unterordner (fotos, masse, material, termine, raum):
      // lesen für Handwerker + Kunde, schreiben nur Handwerker.
      //
      // ACHTUNG: Firestore verknüpft alle passenden Regeln mit ODER. Diese
      // Sammelregel greift deshalb AUCH auf die oben genannten Sammlungen —
      // ohne den Ausschluss würde sie deren engere Regeln wieder aufheben:
      // die Schreibsperre der Nachweise ebenso wie die Leseeinschränkung des
      // Protokolls. Der Ausschluss muss deshalb für read UND write gelten;
      // die eigenen Regeln oben erteilen die Rechte, die dort gelten sollen.
      //
      // Wer später eine weitere geschützte Sammlung ergänzt, muss sie AUCH
      // hier eintragen — sonst greift wieder diese weite Regel.
      match /{unterordner}/{docId} {
        allow read: if angemeldet() &&
          (istHandwerkerVon(bid) || istKundeVon(bid)) &&
          !(unterordner in eigeneRegeln());
        allow write: if angemeldet() && istHandwerkerVon(bid) &&
          !(unterordner in eigeneRegeln());
      }
    }

    // ------------------------------------------------------ zulagenKatalog
    // Preise und Beschreibungen der wählbaren Zusatzleistungen.
    // Der Kunde im Portal liest sie nicht hierüber, sondern bekommt sie von
    // der Cloud Function geliefert — er ist ja nicht angemeldet.
    //
    // Schreibrecht bewusst NICHT über istHandwerker(): diese Sammlung ist
    // global (nicht an eine Baustelle gebunden), ihr Inhalt bestimmt direkt
    // die Rechnungsgrundlage jeder Freigabe. Nur der Betriebsinhaber selbst
    // darf sie ändern.
    match /zulagenKatalog/{sku} {
      allow read: if angemeldet();
      allow write: if istBesitzer();
    }

    // ----------------------------------------------------------- magicLinks
    // Enthält die Zugangs-Abdrücke der Kundenlinks. Kein Client darf hier
    // lesen oder schreiben: Wer diese Sammlung lesen könnte, sähe, welche
    // Zugänge existieren, und könnte Verifikations-Zähler zurücksetzen.
    // Ausschließlich die Cloud Functions greifen darauf zu.
    match /magicLinks/{tokenAbdruck} {
      allow read, write: if false;
    }
  }
}
